# ==============================================================================
# FILM FESTIVAL AWARDS 2026 - ENVIRONMENT VARIABLES
# Single Source of Truth: PRD.md
# ==============================================================================

# Supabase Configuration
# Replace these with your actual Supabase project URL and keys from the dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta

# Voting Schedule Settings (Matches PRD Section 6)
# Format: ISO 8601 with Asia/Jakarta (+07:00) timezone offset
NEXT_PUBLIC_VOTING_DEADLINE=2026-12-04T23:59:59+07:00

# Cloudflare Turnstile / CAPTCHA (Matches PRD Section 5 & 10)
# Optional in local development; required in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

